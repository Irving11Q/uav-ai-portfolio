# ===== 通义千问 DashScope（OpenAI 兼容模式）=====
# 必填：在等号后粘贴你的 DashScope API Key（不要加引号、不要加空格）
DASHSCOPE_API_KEY=
LLM_MODEL=qwen-plus
EMBEDDING_MODEL=text-embedding-v3
EMBEDDING_BACKEND=dashscope
# DashScope text-embedding 单次最大条数（text-embedding-v3 上限 10），超限会报 400
EMBEDDING_BATCH_SIZE=10

# ===== 分块与检索 =====
CHUNK_SIZE=600
CHUNK_OVERLAP=80
RETRIEVE_TOP_K=5
# 混合检索候选池（向量 + BM25 各自召回后融合的候选数）
HYBRID_POOL_SIZE=20

# ===== Rerank 重排（gte-rerank-v2）=====
# 注意必须带 -v2：老的 gte-rerank 已返回 403，会被降级逻辑吞掉导致重排静默失效
RERANK_ENABLED=true
RERANK_MODEL=gte-rerank-v2
RERANK_TOP_N=10

# ===== 语义缓存 =====
CACHE_ENABLED=true
# 余弦相似度阈值，越接近 1 越保守（仅几乎同一句才复用答案），建议 0.95~0.99
CACHE_SIMILARITY_THRESHOLD=0.96

# ===== 限流与并发（企业级稳定性）=====
RATE_LIMIT_PER_USER_PER_MIN=20
LLM_MAX_CONCURRENCY=4

# ===== OCR 预处理（可选增强：扫描版商品图册 / 截图型说明书）=====
# 走通义千问视觉模型，无需本地安装 OCR 引擎；关闭后图片类文件将无法索引
OCR_ENABLED=true
# 视觉模型：qwen-vl-ocr 专做文字提取；也可换 qwen-vl-max 等通用多模态模型
OCR_MODEL=qwen-vl-ocr
# PDF 每页可提取文本少于该字符数 → 判定为扫描版，自动转 OCR
OCR_MIN_TEXT_PER_PAGE=50
# 单篇文档最多 OCR 页数（成本与耗时兜底）
OCR_MAX_PAGES=20
# 渲染扫描版 PDF 时的放大倍数
OCR_RENDER_SCALE=2.0

# ===== 安全与管理员 =====
SECRET_KEY=change-me-in-production-rag-thesis-2026
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ADMIN_USERNAME=admin
ADMIN_PASSWORD=123456

# 说明：LLM_MODEL / RETRIEVE_TOP_K / RERANK_ENABLED / CACHE_ENABLED 等参数
# 已支持管理员在「系统设置」页在线调整（改完立即生效，无需重启）。
# 这里的值只是默认值；后台改过的值存在数据库里，优先级更高，点「恢复默认」可清空。
